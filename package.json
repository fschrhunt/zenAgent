{
  "name": "zen-agent",
  "version": "0.1.0",
  "description": "Make agent browsing chill: quiet, Space-aware background automation for Zen Browser over MCP, with a guided setup wizard.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fschrhunt/zen-agent.git"
  },
  "homepage": "https://github.com/fschrhunt/zen-agent#readme",
  "bugs": {
    "url": "https://github.com/fschrhunt/zen-agent/issues"
  },
  "keywords": [
    "zen-browser",
    "browser-automation",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "bin": {
    "zen-agent": "dist/cli.js",
    "zen-agent-host": "dist/native-host.js",
    "zen-agent-mcp": "dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "extension",
    "native",
    "scripts/build-speech-helper.mjs"
  ],
  "bundleDependencies": [
    "@clack/core",
    "@modelcontextprotocol/sdk",
    "zod"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-speech-helper.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run version:check && npm run safety:background && npm run test:coverage && npm run build && npm run package:check && npm run release:check",
    "dev": "tsx src/cli.ts",
    "extension:pack": "node scripts/package-extension.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "homebrew:formula": "node scripts/render-homebrew-formula.mjs",
    "lint": "eslint .",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "release:check": "node scripts/check-release-artifacts.mjs",
    "safety:background": "node scripts/check-background-safety.mjs",
    "speech:build": "node scripts/build-speech-helper.mjs --required",
    "spike:transport": "ZEN_SPIKE=1 vitest run test/integration",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
