{
  "manifest_version": 3,
  "name": "Zen Agent",
  "version": "0.1.0",
  "description": "Lets Zen Agent find and open tabs across your Zen Spaces for your agents, without stealing focus, switching your Space, or changing the tab you are on.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-agent@zen-agent.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "zenAgent": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "api/parent.js",
        "paths": [["zenAgent"]]
      }
    }
  }
}
